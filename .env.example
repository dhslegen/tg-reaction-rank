# 复制为 .env 后填写。迁移服务器时 data/ 目录和这个文件必须一起带走：
# Telegram 登录状态用 APP_SECRET 加密，换了 APP_SECRET 就要重新登录。
# Copy to .env. When migrating, take data/ AND this file: the Telegram session is encrypted with APP_SECRET.

# 网页管理员密码 / Admin password for the web UI
ADMIN_PASSWORD=

# 至少 32 个字符的随机串，生成：openssl rand -hex 32 / Random string, >= 32 chars
APP_SECRET=

# 在 https://my.telegram.org → API development tools 申请 / Get from my.telegram.org
TG_API_ID=
TG_API_HASH=

# 宿主机端口（默认只监听 127.0.0.1）/ Host port (bound to 127.0.0.1 by default)
PORT=8000

# 时区：决定「近 7 天」的日界线和定时任务时间 / Timezone for day boundaries and schedules
TZ=Asia/Shanghai

# 可选：连接 Telegram 用的代理 / Optional proxy for Telegram
# 例 e.g. socks5://127.0.0.1:1080  socks5://user:pass@host:1080  http://host:8080
TG_PROXY=

# 可选：信任哪些反向代理传来的 X-Forwarded-For / X-Forwarded-Proto（逗号分隔的 IP 或网段）
# 留空 = 不信任，登录限流按连接来源 IP 计算。详见 README「反向代理」一节。
# Optional: trusted reverse proxies (IPs/CIDRs). Empty = trust none. See README.
FORWARDED_ALLOW_IPS=

# 可选：预构建镜像 / Optional prebuilt image
# TGRANK_IMAGE=ghcr.io/dhslegen/tg-reaction-rank:latest
